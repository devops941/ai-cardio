# Anthropic API key (server side only, never in browser code).
ANTHROPIC_API_KEY="sk-ant-your-key-here"
# Optional Groq fallback, used when the Anthropic call fails or the key is absent.
GROQ_API_KEY=""
# auto = Anthropic first then Groq; anthropic | groq force one provider.
LLM_PROVIDER="auto"

# Shared secret; must equal the value in web/.env.local
INTERNAL_API_KEY="replace-with-a-long-random-internal-key"
# Allowed browser origin for CORS.
CORS_ORIGIN="http://localhost:3000"

# Vector store folder.
CHROMA_PATH="./data/chroma"
# Embedding model (384-d, downloaded on first run, ~90 MB).
EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Explanation model and heart-only classifier model.
LLM_MODEL="claude-sonnet-4-5"
GUARD_MODEL="claude-haiku-4-5"
GROQ_LLM_MODEL="llama-3.3-70b-versatile"
GROQ_GUARD_MODEL="llama-3.1-8b-instant"

# true = no network LLM calls (development and tests).
LLM_MOCK="true"
# Optional failure injection for tests: unavailable | bad_json
LLM_MOCK_FAIL=""

LLM_MAX_TOKENS="1500"
GUARD_TIMEOUT_S="8"
LLM_TIMEOUT_S="25"
# Minimum best cosine similarity before the LLM is called.
SIM_THRESHOLD="0.35"
# Number of chunks retrieved.
TOP_K="5"

# Saved ML models and the initial training CSV.
MODELS_DIR="./models"
DATASET_PATH="./datasets/heart_cleveland.csv"

# Upload size cap in megabytes.
MAX_UPLOAD_MB="20"
